{
  "name": "determa-micro-runtime",
  "version": "1.0.0",
  "description": "Local execution legitimacy runtime utility",
  "directories": {
    "example": "examples"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "proof": "tsx factory/proof_runner.ts",
    "proof:rollback": "tsx factory/proof_rollback.ts",
    "proof:replay": "tsx factory/proof_replay.ts",
    "verify:receipts": "tsx factory/verify_receipts.ts",
    "runtime:gate": "tsx factory/runtime_gate.ts",
    "start": "tsx factory/task_runner.ts"
  },
  "keywords": [
    "runtime",
    "deterministic",
    "verification",
    "rollback",
    "replay-protection"
  ],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@types/node": "^25.9.1",
    "tsx": "^4.22.3",
    "typescript": "^5.8.3"
  }
}
